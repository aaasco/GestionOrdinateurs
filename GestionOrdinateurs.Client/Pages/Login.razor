
@page "/login"
@using Blazored.SessionStorage
@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage
@inject NavigationManager Navigation

<h3>Connexion</h3>

<div class="mb-3">
    <label>Login :</label>
    <input class="form-control" @bind="login" />
</div>

<button class="btn btn-primary" @onclick="SeConnecter">
    Se connecter
</button>

<p class="text-danger">@messageErreur</p>

@code {
    private string login = "";
    private string messageErreur = "";

    // Vérifie le login et récupère le token JWT
    private async Task SeConnecter()
    {
        messageErreur = "";

        // Vérifie que le login est renseigné
        if (string.IsNullOrWhiteSpace(login))
        {
            messageErreur = "Veuillez saisir un login.";
            return;
        }

        // Crée un client HTTP pour appeler l'API d'authentification
        HttpClient client = HttpClientFactory.CreateClient("AuthentificationApi");

        // Demande un token JWT à partir du login
        HttpResponseMessage response = await client.PostAsync(
            $"api/Authentication/login?login={Uri.EscapeDataString(login)}",
            null
        );

        // Vérifie si l'utilisateur existe
        if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            messageErreur = "Cet utilisateur n'existe pas.";
            return;
        }

        // Vérifie si la connexion a réussi
        if (!response.IsSuccessStatusCode)
        {
            messageErreur = "Une erreur est survenue lors de la connexion.";
            return;
        }

        // Récupère le token JWT renvoyé par l'API
        string token = await response.Content.ReadAsStringAsync();

        // Enregistre le token dans la session du navigateur
        await SessionStorage.SetItemAsync("token", token);

        // Redirige vers la page d'accueil
        Navigation.NavigateTo("/");
    }
}
