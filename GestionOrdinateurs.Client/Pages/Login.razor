
@page "/login"

@using System.Net.Http.Json
@using System.Text.Json
@using Blazored.SessionStorage

@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage
@inject NavigationManager Navigation

<h3>Connexion</h3>

<div class="mb-3">
    <label>Identifiant</label>
    <input class="form-control" @bind="username" />
</div>

<div class="mb-3">
    <label>Mot de passe</label>
    <input class="form-control" type="password" @bind="password" />
</div>

<button class="btn btn-primary" @onclick="SeConnecter">
    Se connecter
</button>

@if (!string.IsNullOrEmpty(messageErreur))
{
    <p class="text-danger">@messageErreur</p>
}

@code {
    private string username = "";
    private string password = "";
    private string messageErreur = "";

    private async Task SeConnecter()
    {
        messageErreur = "";

        try
        {
            HttpClient client =
                HttpClientFactory.CreateClient("AuthentificationApi");

            // Envoie les identifiants à notre API d'authentification
            HttpResponseMessage response = await client.PostAsJsonAsync(
                "api/Authentication/login",
                new
                {
                    Username = username,
                    Password = password
                });

            if (!response.IsSuccessStatusCode)
            {
                messageErreur = "Identifiant ou mot de passe incorrect.";
                return;
            }

            // Récupère le JWT renvoyé par Keycloak
            using JsonDocument resultat =
                await JsonDocument.ParseAsync(
                    await response.Content.ReadAsStreamAsync());

            string? token = resultat.RootElement
                .GetProperty("access_token")
                .GetString();

            if (string.IsNullOrEmpty(token))
            {
                messageErreur = "Aucun token reçu.";
                return;
            }

            // Sauvegarde le JWT dans la session
            await SessionStorage.SetItemAsync("token", token);

            // Redirige vers l'accueil
            Navigation.NavigateTo("/");
        }
        catch (Exception)
        {
            messageErreur = "Erreur lors de la connexion au serveur.";
        }
    }
}
